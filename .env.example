# Root .env — loaded by Turborepo for all tasks (cache invalidation + task env).
# Each app also has its own env file for running independently:
#   packages/db/.env          → Prisma CLI (db:push, db:generate)
#   apps/web/.env.local       → Next.js dev server
#   apps/worker/.dev.vars     → Wrangler dev server
#   apps/extension/.env.development → Plasmo extension dev

# ── Database (Neon PostgreSQL) ────────────────────────────────────────────────
# Pooled connection (PgBouncer) — used at runtime by app and worker
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Direct connection — used by Prisma CLI for migrations (bypasses pooler)
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# ── Clerk Authentication ───────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/dashboard"
CLERK_WEBHOOK_SECRET="whsec_..."

# ── Worker (Cloudflare) ────────────────────────────────────────────────────────
WORKER_URL="http://localhost:8787"
NEXT_PUBLIC_WORKER_URL="http://localhost:8787"

# ── OpenAI ─────────────────────────────────────────────────────────────────────
# Used in apps/worker only — do NOT expose to apps/web or the extension
OPENAI_API_KEY="sk-..."

# ── PostHog Analytics (optional) ──────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY="phc_..."
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# ── Apps ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
